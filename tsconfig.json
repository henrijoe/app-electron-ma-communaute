{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020", // Changé de ESNext à ES2020 (plus stable)
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler", // Changé de Node à bundler (pour Vite)
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    // Ajouts recommandés pour Vercel/Vite
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client","node"] // Pour le support des types Vite
  },
  "include": ["src"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}